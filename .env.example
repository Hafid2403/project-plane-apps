# ===== Database PostgreSQL (Neon / Supabase / lokal) =====
# Dipakai aplikasi (boleh URL pooler, contoh Neon: host ...-pooler...)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full"
# Dipakai Prisma CLI (migrate, studio, seed). Untuk Neon: host yang sama TANPA "-pooler".
# Boleh dikosongkan, nanti otomatis memakai DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full"

# ===== Better Auth =====
# Buat string acak: npx @better-auth/cli secret   atau   openssl rand -base64 32
BETTER_AUTH_SECRET="ganti-dengan-string-acak-minimal-32-karakter"
BETTER_AUTH_URL="http://localhost:3000"

# ===== Supabase Storage (bucket: ImageUpload, folder public/airplanes) =====
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
NEXT_PUBLIC_SUPABASE_KEY="YOUR_SUPABASE_ANON_PUBLIC_KEY"

# ===== Midtrans (Sandbox) =====
NEXT_PUBLIC_MIDTRANS_TRANSACTION_URL="https://app.sandbox.midtrans.com/snap/v1/transactions"
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="SB-Mid-client-XXXXXXXXXXXXXXXX"
# Base64 dari "SB-Mid-server-XXXXXXXXXXXXXXXX:" (titik dua di akhir ikut di-encode)
NEXT_PUBLIC_MIDTRANS_AUTH_KEY="YOUR_BASE64_ENCODED_MIDTRANS_SERVER_KEY"
